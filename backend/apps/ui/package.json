{
  "name": "profiler-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MSW=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "6.6.5",
    "dayjs": "^1.11.11",
    "highlight.js": "^11.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.0.0",
    "vkbeautify": "^0.99.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vkbeautify": "0.99.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "vite": "8.1.2",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
