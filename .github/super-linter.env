# The default set of validations is listed in https://github.com/Netcracker/.github/blob/main/config/linters/super-linter.env
# If you need to activate a linter that is disabled by default, add it with an empty value as follows:
# VALIDATE_JSCPD=
JAVA_FILE_NAME=checkstyle.xml
# Workaround for https://github.com/Netcracker/qubership-workflow-hub/issues/447
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
# Enable CGO for Go linting (required for jattach library)
CGO_ENABLED=1
# Exclude the Go backend and apps/agent/it-e2e/ from linting until pre-existing issues are
# resolved. The backend no longer sits under one `backend/` prefix, so each of its trees and
# root files is listed: a new Go app under apps/ has to be added here as well.
# Every entry is anchored to the workspace root. An unanchored `tools/.*` also matches
# apps/agent/diagtools/, and `go\.mod` matches the go.mod inside it.
# it-e2e holds Playwright TypeScript specs; super-linter's default ESLint config references
# eslint-plugin-n, which is absent from its image, so any linted TS outside these excludes fails.
FILTER_REGEX_EXCLUDE=^/github/workspace/(apps/(dumps-collector|profiler-backend|ui|examples|agent/it-e2e)/.*|libs/.*|tools/.*|deploy/.*|docs/.*|docker-compose\.yaml|go\.mod)$|(^|/)(\.agents/|\.codex/|\.claude/(apm-hooks\.json|settings\.json|rules/|skills/)|\.cursor/(hooks\.json|rules/))
